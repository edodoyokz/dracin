# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database URL for Drizzle ORM (optional)
# Get this from Supabase project settings > Database > Connection string
# Replace [YOUR-PASSWORD] with your database password
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Upstash Redis - caching and rate limiting
UPSTASH_REDIS_REST_URL=your_redis_url
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# Captain API - provider communication
CAPTAIN_API_TOKEN=your_captain_api_token

# Optional Configuration
# CORS_ALLOWED_ORIGIN=https://yourdomain.com
# RATE_LIMIT_GLOBAL_RPM=45
# RATE_LIMIT_PROVIDER_RPM=10